# Export these variables in your shell; this file is not loaded automatically.
AWS_REGION=eu-west-1
AWS_BUCKET=your-private-upload-bucket
# Prefer an AWS profile locally or an IAM role on AWS.
AWS_PROFILE=default
# Lambda configuration (same region as the two buckets)
SOURCE_BUCKET=your-private-upload-bucket
FLAGGED_BUCKET=your-private-quarantine-bucket
MIN_CONFIDENCE=90
